# Absolute path to the plex-discord-bot SQLite database file
# Windows (mapped network drive):  DB_PATH=Z:\db\plex-requests.db
# Windows (local copy):            DB_PATH=C:\Users\You\plex-requests.db
# Linux / Mac (NAS mount):         DB_PATH=/mnt/nas/plex-bot/db/plex-requests.db
DB_PATH=

# (Optional) Your Discord Bot token
# If provided, requesters show as their actual Discord username.
# If omitted, they show as USER#### (last 4 digits of their Discord ID).
# Use the same token as in your plex-discord-bot .env
DISCORD_TOKEN=

# Port the display server listens on (default: 3000)
PORT=3000

# How often to check the DB for changes, in milliseconds (default: 2000)
POLL_INTERVAL=2000

# Max number of request rows to show on the board (default: 10)
MAX_ROWS=10
